# ===========================================================================
# Consultora DH - variables de entorno (plantilla)
# ===========================================================================
#
# Uso:
#     cp .env.example .env
#
# Después rellene las variables marcadas como OBLIGATORIO. `docker compose`
# se niega a arrancar mientras falte alguna, con un mensaje explícito, en vez
# de fallar más adelante con un error poco claro.
#
# Este archivo NUNCA debe contener una contraseña real. `.env` está en
# `.gitignore` y es el único lugar donde viven los valores de una máquina.
#
# Para generar contraseñas aleatorias:
#     openssl rand -base64 24
# ===========================================================================


# --- Aplicación ------------------------------------------------------------
# Requests per minute, per account, across the authenticated API.
# Only the end to end suite raises this; see app/Providers/AppServiceProvider.php.
API_RATE_LIMIT_PER_MINUTE=120

APP_NAME="Consultora DH"
APP_ENV=local

# Se genera sola la primera vez que arranca el contenedor `app` y queda
# guardada en `.env`. También puede generarse con:
#     docker compose exec app php artisan key:generate
APP_KEY=

# OBLIGATORIO EN PRODUCCIÓN: false.
# Con `true`, una excepción revela traza, archivo y línea. La pantalla de
# Configuración lo muestra en rojo, a propósito.
APP_DEBUG=true

# Debe coincidir con el origen real desde el que se abre la aplicación: se usa
# para generar los enlaces de restablecimiento de contraseña.
APP_URL=http://localhost:8080

# Identificador de la versión, mostrado en Inicio y en Configuración.
APP_VERSION=0.1.0

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# --- Puertos publicados en el host -----------------------------------------
# Se eligen tras revisar los puertos ya ocupados. Si cambia APP_PORT,
# actualice también APP_URL.
APP_PORT=8080
VITE_PORT=5173


# --- Cabeceras de confianza (Host header) ----------------------------------
# Lista de hosts que la aplicación acepta en la cabecera `Host`. La aplicación
# rechaza con 400 cualquier otro host.
#
# Motivo: el flujo de restablecimiento de contraseña construye URL absolutas a
# partir de la petición. Una cabecera `Host` falsificada haría que ese enlace
# apuntara a un servidor del atacante.
#
# EN DESARROLLO puede quedar vacía. Con APP_ENV=local o testing se aceptan
# automáticamente localhost, 127.0.0.1, [::1] y los nombres de servicio de
# Docker (nginx, app), que necesitan las pruebas de extremo a extremo porque se
# ejecutan dentro de la red de Docker.
#
# EN CUALQUIER OTRO ENTORNO es OBLIGATORIA, y no sólo en producción: staging y
# ci se comportan igual. Con la variable vacía la aplicación responde 503 a
# todas las peticiones, en lugar de seguir admitiendo localhost.
#     TRUSTED_HOSTS=portal.consultoradh.com,www.consultoradh.com
#
# Los valores son NOMBRES DE DOMINIO LITERALES, no expresiones regulares. Cada
# entrada se escapa y se ancla, de modo que los puntos son literales y una
# entrada como .* se descarta por no ser un nombre de dominio. Los subdominios
# con comodín no se admiten aquí.
TRUSTED_HOSTS=


# --- Política de seguridad de contenido (CSP) ------------------------------
# Desactivada en desarrollo: el servidor de Vite necesita `eval` para la recarga
# en caliente, sirve los módulos desde otro origen e inyecta scripts en línea.
# Actívela en producción, con los recursos ya compilados. Ver docs/SECURITY.md.
CSP_ENABLED=false


# --- Registro (bitácora) ---------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# `debug` en desarrollo; `info` en producción.
LOG_LEVEL=debug


# ===========================================================================
# Base de datos PostgreSQL
# ===========================================================================
#
# Hay DOS roles distintos, con propósitos distintos:
#
#   1. El rol BOOTSTRAP (POSTGRES_*), superusuario de PostgreSQL. Lo crea la
#      imagen oficial y lo usan ÚNICAMENTE los scripts de inicialización para
#      crear bases de datos y conceder privilegios. Laravel nunca se conecta
#      con él.
#
#   2. El rol de la APLICACIÓN (DB_USERNAME / DB_PASSWORD), propietario de las
#      bases de datos de Consultora DH y SIN privilegios de superusuario. Es
#      el único con el que se conecta Laravel y con el que se ejecutan las
#      migraciones.
#
# Detalle completo en docs/SECURITY.md y docs/DEVELOPMENT.md.
# ===========================================================================

# --- Configuración que usa Laravel ------------------------------------------
DB_CONNECTION=pgsql

# Host del contenedor. Dentro de la red de Docker; nunca se publica al exterior.
DB_HOST=postgres
DB_PORT=5432

DB_DATABASE=consultora_dh

# Base de datos exclusiva de la suite de pruebas. Es DESTRUCTIVA: nunca debe
# coincidir con DB_DATABASE. `tests/Pest.php` aborta la ejecución si coinciden.
DB_TEST_DATABASE=consultora_dh_test

# Base de datos exclusiva de las pruebas end to end (Playwright). Es DESTRUCTIVA:
# nunca debe coincidir con DB_DATABASE ni con DB_TEST_DATABASE. La suite crea
# registros reales, y por eso tiene su propia base en lugar de escribir en la de
# desarrollo y después adivinar cuáles eran suyos.
# `scripts/reset-e2e-db.sh` se niega a migrar si el nombre resuelto no es este.
DB_E2E_DATABASE=consultora_dh_e2e

# Rol de la aplicación. NO es superusuario.
DB_USERNAME=consultora_dh_app

# OBLIGATORIO. Sin este valor `docker compose` no arranca.
DB_PASSWORD=

# --- Inicialización del contenedor PostgreSQL ------------------------------
# Las usa la imagen oficial y los scripts de `docker/postgres/init/` al crear el
# volumen por primera vez. Laravel no lee ninguna de estas tres.
POSTGRES_DB=consultora_dh

# Rol bootstrap: superusuario de PostgreSQL, sólo para inicialización.
POSTGRES_USER=postgres

# OBLIGATORIO. Contraseña del rol bootstrap.
POSTGRES_PASSWORD=postgres

# --- Backup / restore (perfil `ops`) ---------------------------------------
# Rol dedicado, distinto del rol de aplicación (que es NOCREATEDB). Tiene
# CREATEDB para poder restaurar en una base disposable y pertenece a
# pg_read_all_data para poder volcar todas las tablas sin ser propietario.
BACKUP_DB_USER=consultora_dh_backup
BACKUP_DB_PASSWORD=

# El backup se niega a ejecutarse sin cifrado cuando esto vale true. Elija UNA
# forma de clave: passphrase en el entorno o fichero de clave montado.
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_ENCRYPTION_KEY_FILE=

# Directorio del host donde se guardan los backups. En producción debe ser un
# montaje persistente y, preferiblemente, externo al host de la aplicación.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=2
BACKUP_RETRY_SECONDS=300
BACKUP_MAX_AGE_HOURS=36

# Copia adicional (off-host). Debe ser otro montaje, nunca el mismo directorio.
# Añada el bind correspondiente en un docker-compose.override.yml local.
# BACKUP_OFFSITE_DIR=/backups-offsite


# --- Redis (caché, sesiones, colas y límite de intentos) -------------------
# Redis no se publica en el host: sólo es accesible desde la red de Docker.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# OBLIGATORIA en desarrollo y en producción. Docker levanta Redis con
# `--requirepass`, y compose.yaml se niega a arrancar si esta variable está
# vacía: sin ella, cualquiera que alcance Redis lee y modifica las sesiones de
# todos los usuarios, las colas y los contadores de intentos de acceso.
REDIS_PASSWORD=redis

# 0 = datos (colas, límites de intentos); 1 = caché. Separarlos evita que una
# operación de caché descarte un trabajo encolado.
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Un trabajo se vuelve visible para otro worker cuando pasa retry_after. Debe
# superar el timeout más largo (importaciones: 600 s) con margen suficiente.
REDIS_QUEUE_RETRY_AFTER=900
DB_QUEUE_RETRY_AFTER=900

# No publicar un job hasta que la transacción que lo creó haya hecho commit.
QUEUE_AFTER_COMMIT=true

# Umbrales de `php artisan queue:health --strict` (monitorización externa).
QUEUE_MONITORED_QUEUES=default,imports,support,notifications,automations,ai-tasks
QUEUE_MAX_BACKLOG=1000
QUEUE_MAX_AGE_SECONDS=300
QUEUE_MAX_FAILED=0


# --- Correo ----------------------------------------------------------------
# `log` escribe el mensaje en storage/logs/laravel.log, lo que permite ejercitar
# el flujo de recuperación de contraseña sin configurar un servidor SMTP.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@consultora-dh.local"
MAIL_FROM_NAME="${APP_NAME}"


# --- Archivos -------------------------------------------------------------
FILESYSTEM_DISK=local


# --- Interfaz (Vite) ------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Ponga 1 si el proyecto está en un disco que no entrega eventos inotify (WSL,
# Docker Desktop, unidades de red): el servidor de Vite usará sondeo.
#
# El montaje de compose.yaml es un bind de un directorio de Windows servido
# por WSL, que es justo ese caso, así que el valor por defecto es 1. Con 0 el
# servidor arranca y responde, pero su grafo de módulos nunca se invalida:
# sigue sirviendo la transformación del último arranque y la pantalla del
# navegador se queda atrás sin que nada falle ni avise. FIX-EXPORT-IMPORT-04.
VITE_USE_POLLING=1


# ===========================================================================
# A06: Soporte, Realtime, Email, PWA, Telegram, Automatizaciones
# ===========================================================================

# --- Laravel Reverb (WebSocket self-hosted) --------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Broadcasting
BROADCAST_CONNECTION=reverb

# --- Soporte: Email entrante (HMAC) ----------------------------------------
# The shared secret the mail provider signs with. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Never commit a real value. An empty value makes the endpoint answer 503
# rather than accept unsigned mail, which is the intended failure mode.
SUPPORT_INBOUND_DOMAIN=support.consultora-dh.local
SUPPORT_INBOUND_SECRET=

# Largest inbound payload accepted, in bytes. Checked before any MIME parsing.
SUPPORT_INBOUND_MAX_BYTES=10485760

# Accepted clock difference between the signed timestamp and this server.
# Enforced in both directions, so a stamp from the future is refused too.
SUPPORT_INBOUND_TIMESTAMP_SKEW_SECONDS=300

# How long a used nonce is remembered. Bounds how long a captured but valid
# signature can be replayed. A nonce is claimed only after the signature
# has been verified, so an invalid attempt cannot deny a real delivery.
SUPPORT_INBOUND_NONCE_TTL_SECONDS=300

# Budget for the inbound webhook, kept separate from the session API limiter
# so a busy mailbox cannot exhaust the pool the browser session draws from.
SUPPORT_INBOUND_RATE_LIMIT_PER_MINUTE=120

# Email fallback: the wait before a client is told a human has answered.
# Zero would send a fallback for every reply, which is what this prevents.
SUPPORT_FALLBACK_DELAY_MINUTES=15

# --- VAPID (Web Push) ------------------------------------------------------
#
# Generate a real pair for this installation rather than copying one:
#
#     php artisan push:generate-vapid-keys --env=.env --write
#
# The command prints the public key only. The private key is written to the
# environment file and is never echoed: a key that reaches a terminal reaches
# shell history, CI logs and screen shares, and anyone holding it can
# impersonate this server to every subscribed browser. `.env` is gitignored, so
# nothing generated here can be committed.
#
# Without these the assistant and the application still run; push notifications
# simply do not get sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@consultora-dh.local

# --- Telegram Bot ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Web Push --------------------------------------------------------------
# VAPID keys above are used by minishlink/web-push
# No additional variables needed

# --- Automatizaciones ------------------------------------------------------
# No additional environment variables needed for automation engine
# Uses existing scheduler and queue infrastructure

# --- Colas A06 -------------------------------------------------------------
# Add to existing queue worker: --queue=default,imports,support,notifications,automations
# See compose.yaml for queue service configuration

# ===========================================================================
# A07: AI Assistant
# ===========================================================================

# Enable/disable the AI assistant feature
AI_ENABLED=false

# Primary AI provider (OpenAI-compatible API)
#
# Any host serving the OpenAI chat-completions shape works, including the
# free ones. `AI_*_BASE_URL` is the host root; the code appends
# `/chat/completions` itself.
#
# --- A working free configuration, no card required ----------------------
#
#   Get a key:  https://openrouter.ai/settings/keys
#   Free models: https://openrouter.ai/models?fmt=cards&max_price=0
#
# OpenRouter's free tier is rate limited rather than credit limited: models
# whose id ends in `:free` cost nothing and work on a zero balance. Two
# conditions are worth knowing before relying on it:
#
#   - It is free in the sense of costing no money, not in the sense of being
#     unlimited. A key with no purchased credits is limited to roughly
#     20 requests a minute and 50 a day. This application therefore fails
#     gracefully rather than retrying: a rate limit is reported to the user
#     instead of being retried in a loop.
#   - Prompts sent to a free tier are routed through a provider that may log
#     them. Do not rely on it for anything confidential.
#
#   AI_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
#   AI_PRIMARY_API_KEY=<your key>
#   AI_PRIMARY_MODEL=google/gemma-4-31b-it:free
#
# The model must support tool calling for the assistant to use Consultora DH
# data. Not every free model does. Check before choosing:
#
#   curl -s https://openrouter.ai/api/v1/models \
#     | jq -r '.data[] | select(.id|endswith(":free")) \
#       | select(.supported_parameters | index("tools")) | .id'
#
#   After configuring, prove the whole chain works — including whether the
#   model really emits tool calls — with:
#
#   php artisan ai:check-provider
#
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=

# Fallback AI provider.
#
# Consulted exactly once, and only when the primary fails for a transport
# reason: a refused connection, a timeout, or a rate limit. A rejected
# credential or a malformed request is not retried here, because the covering
# provider has its own key and retrying would only replace a clear "this key is
# wrong" with a second equally wrong answer.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Model pool (BUG-020-R2) ---------------------------------------------
#
# The two slots above are the traditional pair; everything below lets one
# OpenAI-compatible endpoint serve several models. The pool is built from the
# slots, `AI_POOL`, `AI_EXTRA_MODELS` and — for an OpenRouter endpoint — the
# cached free catalogue, then ordered by live health.
#
# AI_POOL is a JSON list; base_url/api_key may be omitted to inherit the
# primary endpoint. `priority` is lower-is-better (the two slots are 10/20).
#
#   AI_POOL='[{"model":"nvidia/nemotron-3.5-lightning:free","priority":5}]'
#
# AI_EXTRA_MODELS is a comma-separated list of OpenRouter model ids added as
# free candidates. The cached catalogue is authoritative: an id that has been
# retired, made paid, or stripped of tool support is dropped automatically.
AI_POOL=
AI_EXTRA_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
AI_EXTRA_MODELS_PRIORITY=5

# Bound on provider calls per question, and the whole-turn budget in seconds.
# The budget must stay below the web server's `fastcgi_read_timeout` (180s), so
# a slow provider surfaces as the assistant's own message, not a proxy timeout.
AI_MAX_ATTEMPTS=4
AI_TOTAL_BUDGET_SECONDS=150

# OpenRouter integration. The catalogue is only ever read from cache on a
# request; refresh it with `php artisan ai:models --refresh` (also scheduled
# every six hours). `openrouter/free` is a real candidate; `openrouter/auto`
# is never used because it may select a paid model.
AI_OPENROUTER_DYNAMIC_POOL=true
AI_OPENROUTER_INCLUDE_FREE_ROUTER=true
AI_OPENROUTER_USE_MODELS_FALLBACK=false
# OpenRouter routes to model providers whose retention and training policies
# differ. This server cannot read the account's free-model privacy setting, so
# `training` is the fail-closed default: OpenRouter still answers general
# questions, but real client data goes only to Groq/Cloudflare. Change this to
# `standard` only after verifying the account's free-model setting is off:
#   https://openrouter.ai/settings/privacy
AI_OPENROUTER_DATA_POLICY=training

# Independent free providers (post-R2)
# ---------------------------------------------------------------------------
# OpenRouter is not the only free tier. Each provider below is an independent
# endpoint with its own key, so a quota wall on one does not stop the
# assistant: the resolver simply moves to the next candidate, and health is
# tracked per (endpoint, model) exactly as it is for OpenRouter.
#
# A provider contributes candidates only when it has a base URL, a key AND at
# least one model id. Leave the key empty and it contributes nothing — the pool
# never advertises a provider the deployment cannot call.
#
# `*_MODELS` is the free-only enforcement for an independent endpoint: this
# application cannot read those providers' price lists, so the operator lists
# only models served on the free plan. The commented ids are current free-plan
# examples to copy and verify against the provider's own catalogue — they are
# NOT enabled by default.
#
# `*_DATA_POLICY` is the privacy gate: `training` means the free tier may use
# the content to train, so real client data must not be sent there and such a
# candidate only serves general questions. `standard` means the terms forbid it.
# The default is the safe one. AI_ALLOW_TRAINING_PROVIDERS=true overrides it
# for the whole deployment and is an explicit decision by the owner.
#
# `*_RPM` / `*_RPD` are optional local request caps (0 = none): the provider's
# own 429 remains authoritative, these only avoid hitting it deliberately.

# GroqCloud — https://api.groq.com/openai/v1 (tool calling on most models)
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Verify against https://console.groq.com/docs/models before enabling:
#   openai/gpt-oss-120b,openai/gpt-oss-20b
# The Llama 3.x ids are Enterprise-only on the free plan as of the current
# catalogue, so they are no longer listed as free examples.
GROQ_MODELS=
GROQ_PRIORITY=150
# Standard since 2026-10-19. Groq Services Agreement (Last Modified 2026-06-22)
# §4.2 forbids training on Inputs/Outputs; inference is not retained by default
# and the account may enable Zero Data Retention. Evidence:
#   https://console.groq.com/docs/legal/services-agreement
#   https://console.groq.com/docs/your-data
# Re-verify before changing; the safe fallback is `training`.
GROQ_DATA_POLICY=standard
GROQ_RPM=0
GROQ_RPD=0

# Cloudflare Workers AI — account id is part of the URL, token is the key
CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1
# Verify against the Workers AI model catalogue; only free-plan (neuron-budget)
# text models belong here. `@cf/openai/gpt-oss-120b` answered a LIVE tool turn
# on 2026-10-19 and is the verified default for this deployment:
#   @cf/openai/gpt-oss-120b,@cf/meta/llama-3.1-8b-instruct-fp8
# The unsuffixed @cf/meta/llama-3.1-8b-instruct alias now resolves to a model
# retired on 2026-05-30 and answers 503, so only explicit variants are listed.
CLOUDFLARE_AI_MODELS=
CLOUDFLARE_AI_PRIORITY=150
# Standard since 2026-10-19. Workers AI Data usage (Last updated 2026-10-16)
# commits to zero data retention for standard inference and states that
# Cloudflare does not train AI models on Customer Content. Evidence:
#   https://developers.cloudflare.com/workers-ai/platform/data-usage/
CLOUDFLARE_AI_DATA_POLICY=standard
CLOUDFLARE_AI_MAX_TOKENS=2048
CLOUDFLARE_AI_RPM=0
CLOUDFLARE_AI_RPD=0

# Google Gemini Developer API — OpenAI-compatible endpoint
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# Verify against https://ai.google.dev/gemini-api/docs/models — free-tier
# eligible models only:
#   gemini-3.5-flash-lite,gemini-3.1-flash-lite
# The 2.5 ids are restricted to prior users and 4-argon/Pro are not on the free
# tier, so only the flash-lite generation is listed.
GEMINI_MODELS=
GEMINI_PRIORITY=150
# The free tier may use content to improve Google products, so it defaults to
# `training`: no real client data leaves for Gemini until this is `standard`.
GEMINI_DATA_POLICY=training
GEMINI_RPM=0
GEMINI_RPD=0

# OpenCode Zen — OPTIONAL and disabled by default. Enable only with a separate,
# legitimate key whose free use is confirmed; never through the OpenCode CLI or
# its interactive session. If it needs billing or a card, leave it off.
OPENCODE_ZEN_ENABLED=false
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODELS=
OPENCODE_ZEN_PRIORITY=250
OPENCODE_ZEN_DATA_POLICY=training
OPENCODE_ZEN_RPM=0
OPENCODE_ZEN_RPD=0

# Let a provider whose free tier may train on the content receive real client
# data. Off by default; turning it on is a documented owner decision.
AI_ALLOW_TRAINING_PROVIDERS=false

# Optional local request caps for OpenRouter itself (0 = none).
AI_OPENROUTER_RPM=0
AI_OPENROUTER_RPD=0

# Progressive per-model cooldown after a failure: base seconds, doubled once
# per consecutive failure, capped. A rejected credential disables the whole
# endpoint; an unknown model is parked until the catalogue is refreshed.
AI_HEALTH_BASE_COOLDOWN_SECONDS=45
AI_HEALTH_MAX_COOLDOWN_SECONDS=1800

# Request timeout in seconds
AI_TIMEOUT_SECONDS=30

# Temperature for model responses (0.0 - 1.0)
AI_TEMPERATURE=0.2

# Proposal TTL in minutes (how long a write proposal stays pending)
AI_PROPOSAL_TTL_MINUTES=15

# Artifact TTL in days (how long generated artifacts are kept)
AI_ARTIFACT_TTL_DAYS=30

# Web search configuration (SearXNG-compatible)
#
# The assistant searches through a self-hosted SearXNG instance, which is free
# and needs no API key. It ships with this project but is opt-in, so start it
# with:
#
#     docker compose --profile search up -d searxng
#
# It publishes no host port and is reachable only as `http://searxng:8080`
# from inside the project's own network. A plain `docker compose up` does not
# start it, so an installation that never enables web research is unaffected.
#
# With this unset the assistant still works and answers from its own knowledge
# and from Consultora DH data; it simply reports that web research is not
# configured instead of pretending to search.
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_BASE_URL=
AI_WEB_SEARCH_TIMEOUT_SECONDS=20

# Outbound timeout for reading a page the model asked for. A turn's remaining
# time caps it further, so this is the ceiling, not a fixed wait.
AI_WEB_FETCH_TIMEOUT_SECONDS=15

# MCP (Model Context Protocol) configuration
# MCP server is available at /api/mcp/rpc
# Tokens are managed via /api/mcp-tokens (requires mcp.tokens.manage permission)