# ===========================================================================
# Consultora DH - variables de entorno (plantilla)
# ===========================================================================
#
# Uso:
#     cp .env.example .env
#
# Después rellene las variables marcadas como OBLIGATORIO. `docker compose`
# se niega a arrancar mientras falte alguna, con un mensaje explícito, en vez
# de fallar más adelante con un error poco claro.
#
# Este archivo NUNCA debe contener una contraseña real. `.env` está en
# `.gitignore` y es el único lugar donde viven los valores de una máquina.
#
# Para generar contraseñas aleatorias:
#     openssl rand -base64 24
# ===========================================================================


# --- Aplicación ------------------------------------------------------------
# Requests per minute, per account, across the authenticated API.
# Only the end to end suite raises this; see app/Providers/AppServiceProvider.php.
API_RATE_LIMIT_PER_MINUTE=120

APP_NAME="Consultora DH"
APP_ENV=local

# Se genera sola la primera vez que arranca el contenedor `app` y queda
# guardada en `.env`. También puede generarse con:
#     docker compose exec app php artisan key:generate
APP_KEY=

# OBLIGATORIO EN PRODUCCIÓN: false.
# Con `true`, una excepción revela traza, archivo y línea. La pantalla de
# Configuración lo muestra en rojo, a propósito.
APP_DEBUG=true

# Debe coincidir con el origen real desde el que se abre la aplicación: se usa
# para generar los enlaces de restablecimiento de contraseña.
APP_URL=http://localhost:8080

# Identificador de la versión, mostrado en Inicio y en Configuración.
APP_VERSION=0.1.0

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# --- Puertos publicados en el host -----------------------------------------
# Se eligen tras revisar los puertos ya ocupados. Si cambia APP_PORT,
# actualice también APP_URL.
APP_PORT=8080
VITE_PORT=5173


# --- Cabeceras de confianza (Host header) ----------------------------------
# Lista de hosts que la aplicación acepta en la cabecera `Host`. La aplicación
# rechaza con 400 cualquier otro host.
#
# Motivo: el flujo de restablecimiento de contraseña construye URL absolutas a
# partir de la petición. Una cabecera `Host` falsificada haría que ese enlace
# apuntara a un servidor del atacante.
#
# EN DESARROLLO puede quedar vacía. Con APP_ENV=local o testing se aceptan
# automáticamente localhost, 127.0.0.1, [::1] y los nombres de servicio de
# Docker (nginx, app), que necesitan las pruebas de extremo a extremo porque se
# ejecutan dentro de la red de Docker.
#
# EN CUALQUIER OTRO ENTORNO es OBLIGATORIA, y no sólo en producción: staging y
# ci se comportan igual. Con la variable vacía la aplicación responde 503 a
# todas las peticiones, en lugar de seguir admitiendo localhost.
#     TRUSTED_HOSTS=portal.consultoradh.com,www.consultoradh.com
#
# Los valores son NOMBRES DE DOMINIO LITERALES, no expresiones regulares. Cada
# entrada se escapa y se ancla, de modo que los puntos son literales y una
# entrada como .* se descarta por no ser un nombre de dominio. Los subdominios
# con comodín no se admiten aquí.
TRUSTED_HOSTS=


# --- Política de seguridad de contenido (CSP) ------------------------------
# Desactivada en desarrollo: el servidor de Vite necesita `eval` para la recarga
# en caliente, sirve los módulos desde otro origen e inyecta scripts en línea.
# Actívela en producción, con los recursos ya compilados. Ver docs/SECURITY.md.
CSP_ENABLED=false


# --- Registro (bitácora) ---------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# `debug` en desarrollo; `info` en producción.
LOG_LEVEL=debug


# ===========================================================================
# Base de datos PostgreSQL
# ===========================================================================
#
# Hay DOS roles distintos, con propósitos distintos:
#
#   1. El rol BOOTSTRAP (POSTGRES_*), superusuario de PostgreSQL. Lo crea la
#      imagen oficial y lo usan ÚNICAMENTE los scripts de inicialización para
#      crear bases de datos y conceder privilegios. Laravel nunca se conecta
#      con él.
#
#   2. El rol de la APLICACIÓN (DB_USERNAME / DB_PASSWORD), propietario de las
#      bases de datos de Consultora DH y SIN privilegios de superusuario. Es
#      el único con el que se conecta Laravel y con el que se ejecutan las
#      migraciones.
#
# Detalle completo en docs/SECURITY.md y docs/DEVELOPMENT.md.
# ===========================================================================

# --- Configuración que usa Laravel ------------------------------------------
DB_CONNECTION=pgsql

# Host del contenedor. Dentro de la red de Docker; nunca se publica al exterior.
DB_HOST=postgres
DB_PORT=5432

DB_DATABASE=consultora_dh

# Base de datos exclusiva de la suite de pruebas. Es DESTRUCTIVA: nunca debe
# coincidir con DB_DATABASE. `tests/Pest.php` aborta la ejecución si coinciden.
DB_TEST_DATABASE=consultora_dh_test

# Base de datos exclusiva de las pruebas end to end (Playwright). Es DESTRUCTIVA:
# nunca debe coincidir con DB_DATABASE ni con DB_TEST_DATABASE. La suite crea
# registros reales, y por eso tiene su propia base en lugar de escribir en la de
# desarrollo y después adivinar cuáles eran suyos.
# `scripts/reset-e2e-db.sh` se niega a migrar si el nombre resuelto no es este.
DB_E2E_DATABASE=consultora_dh_e2e

# Rol de la aplicación. NO es superusuario.
DB_USERNAME=consultora_dh_app

# OBLIGATORIO. Sin este valor `docker compose` no arranca.
DB_PASSWORD=

# --- Inicialización del contenedor PostgreSQL ------------------------------
# Las usa la imagen oficial y los scripts de `docker/postgres/init/` al crear el
# volumen por primera vez. Laravel no lee ninguna de estas tres.
POSTGRES_DB=consultora_dh

# Rol bootstrap: superusuario de PostgreSQL, sólo para inicialización.
POSTGRES_USER=postgres

# OBLIGATORIO. Contraseña del rol bootstrap.
POSTGRES_PASSWORD=


# --- Redis (caché, sesiones, colas y límite de intentos) -------------------
# Redis no se publica en el host: sólo es accesible desde la red de Docker.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# OBLIGATORIA en desarrollo y en producción. Docker levanta Redis con
# `--requirepass`, y compose.yaml se niega a arrancar si esta variable está
# vacía: sin ella, cualquiera que alcance Redis lee y modifica las sesiones de
# todos los usuarios, las colas y los contadores de intentos de acceso.
REDIS_PASSWORD=

# 0 = datos (colas, límites de intentos); 1 = caché. Separarlos evita que una
# operación de caché descarte un trabajo encolado.
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis


# --- Correo ----------------------------------------------------------------
# `log` escribe el mensaje en storage/logs/laravel.log, lo que permite ejercitar
# el flujo de recuperación de contraseña sin configurar un servidor SMTP.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@consultora-dh.local"
MAIL_FROM_NAME="${APP_NAME}"


# --- Archivos -------------------------------------------------------------
FILESYSTEM_DISK=local


# --- Interfaz (Vite) ------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Ponga 1 si el proyecto está en un disco que no entrega eventos inotify (WSL,
# Docker Desktop, unidades de red): el servidor de Vite usará sondeo.
VITE_USE_POLLING=0


# ===========================================================================
# A06: Soporte, Realtime, Email, PWA, Telegram, Automatizaciones
# ===========================================================================

# --- Laravel Reverb (WebSocket self-hosted) --------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Broadcasting
BROADCAST_CONNECTION=reverb

# --- Soporte: Email entrante (HMAC) ----------------------------------------
# The shared secret the mail provider signs with. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Never commit a real value. An empty value makes the endpoint answer 503
# rather than accept unsigned mail, which is the intended failure mode.
SUPPORT_INBOUND_DOMAIN=support.consultora-dh.local
SUPPORT_INBOUND_SECRET=

# Largest inbound payload accepted, in bytes. Checked before any MIME parsing.
SUPPORT_INBOUND_MAX_BYTES=10485760

# Accepted clock difference between the signed timestamp and this server.
# Enforced in both directions, so a stamp from the future is refused too.
SUPPORT_INBOUND_TIMESTAMP_SKEW_SECONDS=300

# How long a used nonce is remembered. Bounds how long a captured but valid
# signature can be replayed. A nonce is claimed only after the signature
# has been verified, so an invalid attempt cannot deny a real delivery.
SUPPORT_INBOUND_NONCE_TTL_SECONDS=300

# Budget for the inbound webhook, kept separate from the session API limiter
# so a busy mailbox cannot exhaust the pool the browser session draws from.
SUPPORT_INBOUND_RATE_LIMIT_PER_MINUTE=120

# Email fallback: the wait before a client is told a human has answered.
# Zero would send a fallback for every reply, which is what this prevents.
SUPPORT_FALLBACK_DELAY_MINUTES=15

# --- VAPID (Web Push) ------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@consultora-dh.local

# --- Telegram Bot ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Web Push --------------------------------------------------------------
# VAPID keys above are used by minishlink/web-push
# No additional variables needed

# --- Automatizaciones ------------------------------------------------------
# No additional environment variables needed for automation engine
# Uses existing scheduler and queue infrastructure

# --- Colas A06 -------------------------------------------------------------
# Add to existing queue worker: --queue=default,imports,support,notifications,automations
# See compose.yaml for queue service configuration